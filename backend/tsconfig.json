{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "functions/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "neon.ts"
  ]
}
