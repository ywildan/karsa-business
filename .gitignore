# === Karsa Business — .gitignore ===

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
doc/api/

# Android
**/android/.gradle/
**/android/local.properties
**/android/key.properties
**/android/app/*.jks
**/android/app/*.keystore
**/android/**/gradle-wrapper.jar
**/android/.idea/
**/android/captures/
**/android/gradlew
**/android/gradlew.bat

# Konfig native dibangkitkan CI — repo tidak menyimpannya
# (pola `app/android/*`, bukan `app/android/`, supaya negasi di bawahnya masih dipakai git)
app/android/*
!app/android/AndroidManifest.xml
ios/
**/Generated.xcconfig
**/flutter_export_environment.sh

# Secrets — tidak pernah masuk repo, dalam bentuk apa pun
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
*.pem
*.env
.env
.env.*
.wrangler/
.vercel/
node_modules/

# Berkas kunci lisensi sementara hasil unduhan Actions
release-assets/
*.apk.sha256

# Editor & sistem
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Qoder Sites
.qoder/
*.qoder.site
